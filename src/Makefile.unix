#******************************************************************************
# @file             Makefile.unix
#******************************************************************************
TARGETS             :=  utils boot dlls libc corazon modules init apps

OBJDIR              ?=  $(CURDIR)
SRCDIR              ?=  $(CURDIR)

#SHELL               := /bin/bash

all:

	for d in $(TARGETS); do \
	  if [ ! -d "$(OBJDIR)/$$d" ]; then mkdir -p "$(OBJDIR)/$$d"; fi; \
	  $(MAKE) -C "$(OBJDIR)/$$d" -f "$(SRCDIR)/$$d/Makefile.unix" OBJDIR="$(OBJDIR)/$$d" SRCDIR="$(SRCDIR)/$$d" all; \
	done

clean:

	for d in $(TARGETS); do \
	  if [ -d "$(OBJDIR)/$$d" ]; then \
	    $(MAKE) -C "$(OBJDIR)/$$d" -f "$(SRCDIR)/$$d/Makefile.unix" OBJDIR="$(OBJDIR)/$$d" SRCDIR="$(SRCDIR)/$$d" clean; \
	  fi; \
	done

	for f in `find . -name '*.log'`; do if [ -f $$f ]; then rm -rf $$f; fi; done

ifeq ($(ARCH),AMD64)
amd64/chimaera.img: all
else
i386/chimaera.img: all
endif

	if [ ! -d $(patsubst %/, %, $(dir $@)) ]; then mkdir -p $(patsubst %/, %, $(dir $@)); fi
	if [ -f $@ ]; then rm -rf $@; fi

ifeq ($(ARCH),AMD64)
	utils/dosfstools/mkdosfs --boot boot/kaishi/boot/fat12.bin --sectors 5760 -F 12 -n "CHIMAERA OS" $@
	utils/dosfstools/mmd -i $@ /efi /efi/boot

	utils/dosfstools/mcopy -i $@ boot/kaishi/core/bootx64.efi ::/efi/boot/
	utils/dosfstools/mcopy -i $@ boot/kaishi/core/kaishi.sys ::kaishi
else
	utils/dosfstools/mkdosfs --boot boot/kaishi/boot/fat12.bin --sectors 5760 -F 12 -n "CHIMAERA OS" $@
	utils/dosfstools/mmd -i $@ /efi /efi/boot

	utils/dosfstools/mcopy -i $@ boot/kaishi/core/bootia32.efi ::/efi/boot/
	utils/dosfstools/mcopy -i $@ boot/kaishi/core/kaishi.sys ::kaishi
endif

	utils/dosfstools/mmd -i $@ boot

	utils/dosfstools/mcopy -i $@ $(SRCDIR)/boot/kaishi/kaishi.cfg ::/boot/kaishi.cfg
	utils/dosfstools/mcopy -i $@ corazon/corazon.exe ::/boot/corazon

	utils/dosfstools/mmd -i $@ modules

	utils/dosfstools/mcopy -i $@ modules/axe/axe.mod ::/modules/axe.mod
	utils/dosfstools/mcopy -i $@ modules/pe/pe.mod ::/modules/pe.mod
	utils/dosfstools/mcopy -i $@ modules/msdos/msdos.mod ::/modules/msdos.mod
	utils/dosfstools/mcopy -i $@ modules/armv7/armv7.mod ::/modules/armv7.mod
	utils/dosfstools/mcopy -i $@ modules/shell/shell.mod ::/modules/shell.mod

	utils/dosfstools/mmd -i $@ /sbin

	utils/dosfstools/mcopy -i $@ init/init ::/sbin/init
	utils/dosfstools/mcopy -i $@ apps/w32test/w32test.exe ::/sbin/w32test.exe

	utils/dosfstools/mmd -i $@ /bin

	utils/dosfstools/mcopy -i $@ apps/echo/echo ::/bin/echo
	utils/dosfstools/mcopy -i $@ apps/sh/sh ::/bin/sh
	utils/dosfstools/mcopy -i $@ apps/cat/cat ::/bin/cat
	utils/dosfstools/mcopy -i $@ apps/date/date ::/bin/date
	utils/dosfstools/mcopy -i $@ apps/ls/ls ::/bin/ls
	utils/dosfstools/mcopy -i $@ apps/dir/dir ::/bin/dir
	utils/dosfstools/mcopy -i $@ apps/pwd/pwd ::/bin/pwd
	utils/dosfstools/mcopy -i $@ apps/clear/clear ::/bin/clear
	utils/dosfstools/mcopy -i $@ apps/touch/touch ::/bin/touch
	utils/dosfstools/mcopy -i $@ apps/mkdir/mkdir ::/bin/mkdir
	utils/dosfstools/mcopy -i $@ apps/rm/rm ::/bin/rm
	utils/dosfstools/mcopy -i $@ apps/rmdir/rmdir ::/bin/rmdir
	utils/dosfstools/mcopy -i $@ apps/tar/tar ::/bin/tar
	utils/dosfstools/mcopy -i $@ apps/cp/cp ::/bin/cp

	utils/dosfstools/mmd -i $@ /usr /usr/bin /usr/share /usr/share/fonts /usr/share/fonts/truetype

	utils/dosfstools/mcopy -i $@ apps/atto/atto ::/usr/bin/atto
	utils/dosfstools/mcopy -i $@ apps/which/which ::/usr/bin/which
	utils/dosfstools/mcopy -i $@ apps/unzip/unzip ::/usr/bin/unzip
	utils/dosfstools/mcopy -i $@ apps/wc/wc ::/usr/bin/wc

	utils/dosfstools/mcopy -i $@ $(SRCDIR)/fonts/SpaceMono-Bold.ttf ::/usr/share/fonts/truetype/SpaceMono-Bold.ttf
	utils/dosfstools/mcopy -i $@ $(SRCDIR)/fonts/SpaceMono-Regular.ttf ::/usr/share/fonts/truetype/SpaceMono-Regular.ttf

ifeq ($(ARCH),AMD64)
	utils/dosfstools/mmd -i $@ /nt /nt/System32 /nt/SysWOW64

	utils/dosfstools/mcopy -i $@ dlls/kernel32/amd64/kernel32.dll ::/nt/System32/kernel32.dll
	utils/dosfstools/mcopy -i $@ dlls/msvcrt/amd64/msvcrt.dll ::/nt/System32/msvcrt.dll
	utils/dosfstools/mcopy -i $@ dlls/ntdll/amd64/ntdll.dll ::/nt/System32/ntdll.dll

	utils/dosfstools/mcopy -i $@ dlls/kernel32/i386/kernel32.dll ::/nt/SysWOW64/kernel32.dll
	utils/dosfstools/mcopy -i $@ dlls/msvcrt/i386/msvcrt.dll ::/nt/SysWOW64/msvcrt.dll
	utils/dosfstools/mcopy -i $@ dlls/ntdll/i386/ntdll.dll ::/nt/SysWOW64/ntdll.dll
else
	utils/dosfstools/mmd -i $@ /nt /nt/System32
	utils/dosfstools/mcopy -i $@ dlls/kernel32/i386/kernel32.dll ::/nt/System32/kernel32.dll
	utils/dosfstools/mcopy -i $@ dlls/msvcrt/i386/msvcrt.dll ::/nt/System32/msvcrt.dll
	utils/dosfstools/mcopy -i $@ dlls/ntdll/i386/ntdll.dll ::/nt/System32/ntdll.dll
endif

#	for i in {1..108}; do utils/dosfstools/mmd -i $@ `printf "abc_%04d.txt" $$i`; done
#	utils/dosfstools/mcopy -i $@ $(SRCDIR)/dos/COMMAND.COM ::
