#******************************************************************************
# @file             Makefile.unix
#******************************************************************************
TARGETS             :=  boot core

OBJDIR              ?=  $(CURDIR)
SRCDIR              ?=  $(CURDIR)

VPATH               :=  $(SRCDIR)

all: config.hiv

	for d in $(TARGETS); do \
	  if [ ! -d "$(OBJDIR)/$$d" ]; then mkdir -p "$(OBJDIR)/$$d"; fi; \
	  $(MAKE) -C "$(OBJDIR)/$$d" -f "$(SRCDIR)/$$d/Makefile.unix" OBJDIR="$(OBJDIR)/$$d" SRCDIR="$(SRCDIR)/$$d" all; \
	done

clean:

	if [ -f config.hiv ]; then rm -rf config.hiv; fi

	for d in $(TARGETS); do \
	  if [ -d "$(OBJDIR)/$$d" ]; then \
	    $(MAKE) -C "$(OBJDIR)/$$d" -f "$(SRCDIR)/$$d/Makefile.unix" OBJDIR="$(OBJDIR)/$$d" SRCDIR="$(SRCDIR)/$$d" clean; \
	  fi; \
	done

config.hiv: config.cfg

	../../utils/regf/regf gen $< $@
