#******************************************************************************
# @file             Makefile.unix
#******************************************************************************
SRCDIR              ?=  $(CURDIR)
VPATH               :=  $(SRCDIR)

CC                  :=  gcc
CFLAGS              :=  -D_FILE_OFFSET_BITS=64 -O2 -Wall -Werror -Wextra

CC_SRC              :=  $(wildcard $(SRCDIR)/*.c)

ifeq ($(OS), Windows_NT)
all: java2dex.exe

java2dex.exe: $(CC_SRC)

	$(CC) $(CFLAGS) -o $@ $^
else
all: java2dex

java2dex: $(CC_SRC)

	$(CC) $(CFLAGS) -o $@ $^
endif

clean:

	if [ -f java2dex.exe ]; then rm -rf java2dex.exe; fi
	if [ -f java2dex ]; then rm -rf java2dex; fi
