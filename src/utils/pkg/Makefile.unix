#******************************************************************************
# @file             Makefile.unix
#******************************************************************************
SRCDIR              ?=  $(CURDIR)
VPATH               :=  $(SRCDIR)

CC                  :=  gcc
CFLAGS              :=  -D_FILE_OFFSET_BITS=64 -O2 -Wall -Werror -Wextra

CSRC                :=   comp.c hashtab.c lib.c ll.c manifest.c pkg.c report.c writer.c

ifeq ($(OS), Windows_NT)
all: pkg.exe

pkg.exe: $(CSRC)
	$(CC) $(CFLAGS) -o $@ $^
else
all: pkg

pkg: $(CSRC)
	$(CC) $(CFLAGS) -o $@ $^
endif

clean:

	if [ -f pkg ]; then rm -rf pkg; fi
	if [ -f pkg.exe ]; then rm -rf pkg.exe; fi
