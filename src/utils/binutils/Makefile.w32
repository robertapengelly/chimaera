#******************************************************************************
# @file             Makefile.w32
#******************************************************************************
TARGETS             :=  ar as ld

OBJDIR              ?=  $(CURDIR)
SRCDIR              ?=  $(CURDIR)

all:

	for %%d in ($(TARGETS)) do ( \
	  $(MAKE) -C "$(OBJDIR)" -f "$(SRCDIR)/%%d/Makefile.w32" OBJDIR="$(OBJDIR)" SRCDIR="$(SRCDIR)/%%d" all \
	)

clean:

	for %%d in ($(TARGETS)) do ( \
	  $(MAKE) -C "$(OBJDIR)" -f "$(SRCDIR)/%%d/Makefile.w32" OBJDIR="$(OBJDIR)" SRCDIR="$(SRCDIR)/%%d" clean \
	)
