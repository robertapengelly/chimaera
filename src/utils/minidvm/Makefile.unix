#******************************************************************************
# @file             Makefile.unix
#******************************************************************************
SRCDIR              ?=  $(CURDIR)
VPATH               :=  $(SRCDIR)

CC                  :=  gcc
CFLAGS              :=  -D_FILE_OFFSET_BITS=64 -O2 -Wall -Werror -Wextra

CC_SRC              :=  $(wildcard $(SRCDIR)/*.c)

ifeq ($(OS), Windows_NT)
all: minidvm.exe

minidvm.exe: $(CC_SRC)

	$(CC) $(CFLAGS) -o $@ $^ -lm
else
all: minidvm

minidvm: $(CC_SRC)

	$(CC) $(CFLAGS) -o $@ $^ -lm
endif

clean:

	if [ -f minidvm.exe ]; then rm -rf minidvm.exe; fi
	if [ -f minidvm ]; then rm -rf minidvm; fi
