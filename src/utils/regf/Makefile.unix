#******************************************************************************
# @file             Makefile.unix
#******************************************************************************
SRCDIR              ?=  $(CURDIR)
VPATH               :=  $(SRCDIR)

CC                  :=  gcc
CFLAGS              :=  -D_FILE_OFFSET_BITS=64 -O2 -Wall -Werror -Wextra

CSRC                :=  arena.c edit.c hashtab.c lib.c ll.c parse.c reader.c regf.c report.c security.c tree.c writer.c

ifeq ($(OS), Windows_NT)
all: regf.exe

regf.exe: $(CSRC)
	$(CC) $(CFLAGS) -o $@ $^
else
all: regf

regf: $(CSRC)
	$(CC) $(CFLAGS) -o $@ $^
endif

clean:

	if [ -f regf.exe ]; then rm -rf regf.exe; fi
	if [ -f regf ]; then rm -rf regf; fi
