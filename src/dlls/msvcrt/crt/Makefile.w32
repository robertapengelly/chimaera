#******************************************************************************
# @file             Makefile.w32
#******************************************************************************
OBJDIR              ?=  $(CURDIR)
SRCDIR              ?=  $(CURDIR)

FORMATTED_PATH      :=  $(subst /,\,$(SRCDIR))
VPATH               :=  $(SRCDIR)

clean:

	for /r %%f in (*.o) do ( if exist %%f ( del /q %%f ) )
	for /r %%f in (*.lst) do ( if exist %%f ( del /q %%f ) )

ifeq ($(ARCH),AMD64)
all: amd64/crt0.o

amd64/crt0.o: $(SRCDIR)/amd64/crt0.asm

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/binutils/sasm -f win64 -D__AMD64__ -l crt0.lst -o $@ $<
else
all: i386/crt0.o

i386/crt0.o: $(SRCDIR)/i386/crt0.asm

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/binutils/sasm -f coff -D__I386__ -l crt0.lst -o $@ $<
endif
