#******************************************************************************
# @file             Makefile.w32
#******************************************************************************
OBJDIR              ?=  $(CURDIR)
SRCDIR              ?=  $(CURDIR)

FORMATTED_PATH      :=  $(subst /,\,$(SRCDIR))
VPATH               :=  $(SRCDIR)

ASMSRC              :=  $(subst \,/,$(shell dir /a-d /s /b $(FORMATTED_PATH)\\*.asm | findstr /e ".asm"))
CSRC                :=  $(subst \,/,$(shell dir /a-d /s /b $(FORMATTED_PATH)\\*.c | findstr /e ".c"))

ASMOBJ              :=  $(patsubst $(SRCDIR)/%, %, $(ASMSRC:.asm=.o))
OBJ                 :=  $(patsubst $(SRCDIR)/%, %, $(ASMSRC:.asm=.o) $(CSRC:.c=.o))

COMMA               :=  ,
BLANK               :=
SPACE               :=  $(BLANK) $(BLANK)

TEMP                :=  $(patsubst $(SRCDIR)/%,%,$(CSRC:.c=.def))
CDEF                :=  $(subst $(SPACE),$(COMMA),$(TEMP))

all: msvcrt.def msvcrt.dll

clean:

	for /r %%f in (*.o) do ( if exist %%f ( del /q %%f ) )
	for /r %%f in (*.lst) do ( if exist %%f ( del /q %%f ) )

	if exist msvcrt.dll ( del /q msvcrt.dll )

msvcrt.def: $(ASMOBJ)

	echo EXPORTS > $@

	for %%f in ($(subst /,\,$(ASMOBJ))) do @echo     _%%~nf >> $@
	echo.    __adjust_fdiv DATA >> $@

msvcrt.dll: $(OBJ) $(NTDLL) $(KERNEL32)

	../../../utils/binutils/slink --oformat pe-i386 --shared --kill-at --def-list msvcrt.def,$(CDEF) --out-implib msvcrt.lib -Map msvcrt.map -o $@ $^

%.o: %.s

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../../utils/binutils/sasm -f coff -l $*.lst -o $@ $<

%.s: %.c

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../../utils/scc/scc -Wall -Wextra -Werror -S -m32 -D__I386__ -I$(SRCDIR)/../../../../libc/include -o $@ $<

%.o: %.asm

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../../utils/binutils/sasm -f coff -D__I386__ -l $*.lst -o $@ $<
