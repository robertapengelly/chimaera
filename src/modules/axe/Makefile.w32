#******************************************************************************
# @file             Makefile.w32
#******************************************************************************
OBJDIR              ?=  $(CURDIR)
SRCDIR              ?=  $(CURDIR)

FORMATTED_PATH      :=  $(subst /,\,$(SRCDIR))
VPATH               :=  $(SRCDIR)

ifeq ($(ARCH),AMD64)
CSRC                :=  $(subst \,/,$(shell dir /a-d /s /b $(FORMATTED_PATH)\\*.c | find /v "i386" | findstr /e ".c"))
OBJ                 :=  $(patsubst $(SRCDIR)/%, %, $(CSRCS:.c=.o))
else
CSRC                :=  $(subst \,/,$(shell dir /a-d /s /b $(FORMATTED_PATH)\\*.c | find /v "amd64" | findstr /e ".c"))
OBJ                 :=  $(patsubst $(SRCDIR)/%, %, $(CSRC:.c=.o))
endif

all: axe.mod

clean:

	for /r %%f in (*.o) do ( if exist %%f ( del /q %%f ) )
	for /r %%f in (*.lst) do ( if exist %%f ( del /q %%f ) )

	if exist axe.mod ( del /q axe.mod )

ifeq ($(ARCH),AMD64)
axe.mod: $(OBJ)

	../../utils/binutils/slink --oformat axe-amd64 -N -e _start -Map axe.map -o $@ ../../libc/amd64/crt0.o $^ ../../libc/amd64/libc.a

%.o: %.s

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/binutils/sasm -f win64 -l $*.lst -o $@ $<

%.s: %.c

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/scc/scc -Wall -Wextra -Werror -S -m64 -D__AMD64__ -I$(SRCDIR)/../../libc/include -I$(SRCDIR)/include -o $@ $<

%.o: %.asm

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/binutils/sasm -f win64 -l $*.lst -o $@ $<
else
axe.mod: $(OBJ)

	../../utils/binutils/slink --oformat axe-i386 -N -e _start -Map axe.map -o $@ ../../libc/i386/crt0.o $^ ../../libc/i386/libc.a

%.o: %.s

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/binutils/sasm -f coff -l $*.lst -o $@ $<

%.s: %.c

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/scc/scc -Wall -Wextra -Werror -S -m32 -D__I386__ -I$(SRCDIR)/../../libc/include -I$(SRCDIR)/include -o $@ $<

%.o: %.asm

	if not exist $(subst /,\,$(patsubst %/, %, $(dir $@))) ( mkdir $(subst /,\,$(patsubst %/, %, $(dir $@))) )
	../../utils/binutils/sasm -f coff -D__I386__ -l $*.lst -o $@ $<
endif
